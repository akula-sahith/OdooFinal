    {
      "name": "03 Quotations",
      "item": [
        {
          "name": "Create Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{salesRepToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"priceListId\": {{priceListId}},\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quotations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quotations"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create quotation returns 201', function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
