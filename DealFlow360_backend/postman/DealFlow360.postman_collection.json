{
  "info": {
    "_postman_id": "dealflow360-collection-v1-2026",
    "name": "DealFlow360 Master API Collection",
    "description": "Executable Postman collection for testing DealFlow360 backend REST endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Database & Application Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains UP indicator', function () { pm.expect(pm.response.text()).to.include('DealFlow360 is UP'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Authentication",
      "item": [
        {
          "name": "Register Admin User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"System Administrator\",\n  \"email\": \"admin@dealflow360.com\",\n  \"password\": \"AdminSecret2026!\",\n  \"role\": \"ADMIN\",\n  \"teamId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Admin registration returns 201', function () { pm.response.to.have.status(201); });"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Sales Rep User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex SalesRep\",\n  \"email\": \"alex.rep@dealflow360.com\",\n  \"password\": \"SalesRepPass2026!\",\n  \"role\": \"SALES_REP\",\n  \"teamId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Sales Rep registration returns 201', function () { pm.response.to.have.status(201); });"],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login as Sales Rep",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.rep@dealflow360.com\",\n  \"password\": \"SalesRepPass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('JWT token returned', function () { pm.expect(jsonData.token).to.not.be.null; });",
                  "if (jsonData.token) { pm.environment.set('salesRepToken', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Invalid Password (Negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.rep@dealflow360.com\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Invalid credentials returns 401', function () { pm.response.to.have.status(401); });"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
